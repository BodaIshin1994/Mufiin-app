rules_version = '2';

// Простые правила для внутреннего офисного прототипа:
// - читать и писать может любой, кто вошёл (даже анонимно — см. app.js: signInAnonymously);
// - создавать заказ можно только с корректным статусом "new" и обязательными полями;
// - менять существующий заказ можно только поле status/updatedAt (бариста двигает статус),
//   остальные поля заказа после создания неизменны;
// - удалять заказы через приложение нельзя (история остаётся).
//
// Это защищает от случайных ошибок и от совсем случайных ботов из интернета,
// но НЕ является полноценной защитой уровня продакшена — для реального запуска
// стоит заменить анонимную авторизацию на вход сотрудников (например, по корпоративной почте).

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.floor is string && request.resource.data.floor.size() > 0
        && request.resource.data.drinkId is string
        && request.resource.data.price is number;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new','accepted','preparing','ready','done','cancelled'];

      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.value is int
        && request.resource.data.value >= 0;
    }
  }
}
