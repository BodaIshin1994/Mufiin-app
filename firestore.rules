rules_version = '2';

// Правила офисного прототипа Muffin.
//
// Две категории пользователей:
// - "сотрудник" - анонимный вход (см. app.js: signInAnonymously). Видит и
//   создаёт только СВОИ заказы (по creatorUid), статус менять не может.
// - "бариста" - настоящий вход по email+паролю (Firebase Auth), UID занесён
//   вручную в коллекцию staff/{uid}. Видит все заказы, может двигать статус.
//
// До 2026-08-28 здесь было "allow read/update: if request.auth != null" -
// то есть любой анонимный сотрудник технически мог прочитать и изменить
// (включая отмену) заказ любого коллеги через прямой запрос к Firestore,
// а не только через переключатель "Я бариста" в интерфейсе (который был
// чисто визуальным, без серверной проверки). Обнаружено и исправлено
// по итогам вопроса "можно сделать чтобы у пользователя отдельно было у
// админа отдельно".

service cloud.firestore {
  match /databases/{database}/documents {

    function isBarista() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    match /staff/{uid} {
      // Клиенту нужно уметь проверить "я бариста?" после логина -
      // разрешаем читать только свою же запись, не чужие.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // добавляется вручную из консоли/через Admin SDK
    }

    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (resource.data.creatorUid == request.auth.uid || isBarista());

      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.floor is string && request.resource.data.floor.size() > 0
        && request.resource.data.drinkId is string
        && request.resource.data.price is number;

      // Менять статус (принять/готовить/выдать/отменить) может только бариста -
      // раньше это мог сделать любой авторизованный пользователь.
      allow update: if isBarista()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new','accepted','preparing','ready','done','cancelled'];

      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.value is int
        && request.resource.data.value >= 0;
    }
  }
}